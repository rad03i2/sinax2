/* SINAX Dark Theme - Windows 11 Fluent Inspired */
* {
    font-family: "Segoe UI", "Tahoma", "Arial", sans-serif;
    font-size: 13px;
    color: #E6E6E6;
    outline: none;
}

QMainWindow, QDialog {
    background-color: #202020;
}

QWidget#CentralWidget {
    background-color: #202020;
}

/* Scroll Area */
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Sidebar */
QFrame#SidebarFrame {
    background-color: #21262D;
    border-left: 1px solid #30363D;
}

QPushButton#SidebarToggleBtn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px;
}
QPushButton#SidebarToggleBtn:hover {
    background-color: #30363D;
}

QPushButton.NavButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0px;
    text-align: right;
    font-size: 13px;
    font-weight: 500;
    color: #CCCCCC;
    min-height: 38px;
}

QPushButton.NavButton:hover {
    background-color: #282E37;
    color: #FFFFFF;
}

QPushButton.NavButton:checked, QPushButton.NavButton[active="true"] {
    background-color: #263342;
    color: #60CDFF;
    border-right: 3px solid #60CDFF;
}

QPushButton.NavButton[section_active="true"] {
    background-color: rgba(96, 205, 255, 0.08);
    color: #60CDFF;
    border-right: 3px solid rgba(96, 205, 255, 0.5);
}

QPushButton.NavSubButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    text-align: right;
    font-size: 11px;
    font-weight: 500;
    color: #999999;
    min-height: 32px;
}
QPushButton.NavSubButton:hover {
    background-color: #282E37;
    color: #E0E0E0;
}
QPushButton.NavSubButton[active="true"] {
    background-color: #263342;
    color: #60CDFF;
    font-weight: 600;
    border-right: 2px solid #60CDFF;
}

QPushButton.NavButtonDisabled {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 10px 14px;
    text-align: right;
    font-size: 13px;
    color: #666666;
    min-height: 22px;
}

/* Header & Status Bar */
QFrame#HeaderFrame {
    background-color: #262626;
    border-bottom: 1px solid #333333;
}

QFrame#StatusBarFrame {
    background-color: #262626;
    border-top: 1px solid #333333;
}

/* Tool Cards */
QFrame.ToolCard {
    background-color: #2B2B2B;
    border: 1px solid #383838;
    border-radius: 8px;
    padding: 16px;
}
QFrame.ToolCard:hover {
    background-color: #333333;
    border: 1px solid #0078D4;
}

/* Buttons */
QPushButton {
    background-color: #2D2D2D;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    padding: 6px 14px;
    color: #FFFFFF;
    font-weight: 500;
    min-height: 32px;
}
QPushButton:hover {
    background-color: #383838;
    border-color: #4D4D4D;
}
QPushButton:pressed {
    background-color: #242424;
}
QPushButton:disabled {
    background-color: #222222;
    border-color: #2E2E2E;
    color: #666666;
}

QPushButton.PrimaryButton {
    background-color: #0078D4;
    border: 1px solid #006CBD;
    color: #FFFFFF;
    font-weight: bold;
    min-height: 34px;
}
QPushButton.PrimaryButton:hover {
    background-color: #1084D9;
}
QPushButton.PrimaryButton:pressed {
    background-color: #005A9E;
}

QPushButton.DangerButton {
    background-color: #C42B1C;
    border: 1px solid #A82315;
    color: #FFFFFF;
    min-height: 32px;
}
QPushButton.DangerButton:hover {
    background-color: #D13426;
}

QPushButton.SuccessButton {
    background-color: #107C41;
    border: 1px solid #0E6B38;
    color: #FFFFFF;
    min-height: 32px;
}
QPushButton.SuccessButton:hover {
    background-color: #158A4A;
}

QPushButton.ChipButton {
    background-color: #333333;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    color: #DDDDDD;
    min-height: 28px;
}
QPushButton.ChipButton:hover {
    background-color: #404040;
    border-color: #60CDFF;
    color: #FFFFFF;
}

/* Inputs & Combos */
QLineEdit, QTextEdit, QSpinBox {
    background-color: #2B2B2B;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    padding: 5px 10px;
    color: #FFFFFF;
    selection-background-color: #0078D4;
    min-height: 32px;
}
QLineEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid #60CDFF;
    background-color: #2D2D2D;
}

QComboBox {
    background-color: #2B2B2B;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    padding: 5px 10px;
    color: #FFFFFF;
    min-height: 32px;
}
QComboBox:hover {
    background-color: #333333;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox QAbstractItemView {
    background-color: #2B2B2B;
    border: 1px solid #3D3D3D;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
    padding: 4px;
    min-height: 32px;
}

/* Table View & Table Widget */
QTableView, QTableWidget {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 8px;
    gridline-color: #21262D;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}
QTableView::item, QTableWidget::item {
    padding: 6px 10px;
    min-height: 28px;
}
QTableView::item:hover, QTableWidget::item:hover {
    background-color: #1F242C;
}

/* List Widget */
QListWidget {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 8px;
    padding: 4px;
    color: #F0F6FC;
}
QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin-bottom: 2px;
}
QListWidget::item:hover {
    background-color: #1F242C;
}
QListWidget::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}
QTableView::item:selected, QTableWidget::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #21262D;
    color: #8B949E;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #30363D;
    border-left: 1px solid #21262D;
    font-weight: 600;
    font-size: 12px;
    min-height: 26px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #333333;
    background-color: #242424;
    border-radius: 6px;
    top: -1px;
}
QTabBar::tab {
    background-color: #2A2A2A;
    border: 1px solid #333333;
    padding: 8px 14px;
    margin-left: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #AAAAAA;
    min-height: 22px;
}
QTabBar::tab:selected {
    background-color: #242424;
    color: #60CDFF;
    border-bottom: 2px solid #60CDFF;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background-color: #333333;
    color: #FFFFFF;
}

/* Group Box */
QGroupBox {
    border: 1px solid #383838;
    border-radius: 8px;
    margin-top: 22px;
    padding-top: 16px;
    font-weight: bold;
    color: #60CDFF;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 2px 8px;
    background-color: #262626;
    right: 14px;
}

/* Progress Bar */
QProgressBar {
    background-color: #2D2D2D;
    border: 1px solid #383838;
    border-radius: 5px;
    height: 14px;
    text-align: center;
    color: #FFFFFF;
    font-size: 11px;
}
QProgressBar::chunk {
    background-color: #0078D4;
    border-radius: 4px;
}

/* Checkbox */
QCheckBox {
    spacing: 8px;
    min-height: 24px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #555555;
    background-color: #2B2B2B;
}
QCheckBox::indicator:hover {
    border-color: #60CDFF;
}
QCheckBox::indicator:checked {
    background-color: #0078D4;
    border-color: #0078D4;
}

/* ScrollBar Modern Windows 11 Fluent Design */
QScrollBar:vertical {
    background: #181818;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #444444;
    min-height: 36px;
    border-radius: 4px;
    margin: 1px;
}
QScrollBar::handle:vertical:hover {
    background: #5C5C5C;
}
QScrollBar::handle:vertical:pressed {
    background: #7A7A7A;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: #181818;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #444444;
    min-width: 36px;
    border-radius: 4px;
    margin: 1px;
}
QScrollBar::handle:horizontal:hover {
    background: #5C5C5C;
}
QScrollBar::handle:horizontal:pressed {
    background: #7A7A7A;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QScrollBar::corner {
    background: transparent;
}

/* Tooltip */
QToolTip {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #4D4D4D;
    padding: 6px 10px;
    border-radius: 4px;
}

/* Card Panels & Containers */
#topFrame, #rulesPanel {
    background-color: #262626;
    border: 1px solid #383838;
    border-radius: 8px;
}

#summaryCard {
    background-color: #1F1F1F;
    border: 1px solid #383838;
    border-radius: 6px;
}

/* ToolCard styles */
QFrame[class="ToolCard"] {
    background-color: #262626;
    border: 1px solid #383838;
    border-radius: 8px;
}
QFrame[class="ToolCard"]:hover {
    background-color: #2D2D2D;
    border-color: #60CDFF;
}
QLabel#toolCardTitle {
    font-size: 16px;
    font-weight: bold;
    color: #FFFFFF;
}
QLabel#toolCardDesc {
    font-size: 12px;
    color: #AAAAAA;
}

/* ====================================================================
   SINAX Design System Fluent Tokens & Modern Primitives
   ==================================================================== */

ModernCard {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 10px;
}

MetricCard {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 10px;
}

MetricCard:hover {
    background-color: #1F242C;
    border-color: #484F58;
}

ActionTile {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 10px;
}

ActionTile:hover {
    background-color: #1F242C;
    border-color: #0078D4;
}

PrimaryButton {
    background-color: #0078D4;
    color: #FFFFFF;
    border: 1px solid #0078D4;
    border-radius: 8px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: bold;
}

PrimaryButton:hover {
    background-color: #106EBE;
    border-color: #106EBE;
}

PrimaryButton:pressed {
    background-color: #004578;
}

SecondaryButton {
    background-color: #21262D;
    color: #F0F6FC;
    border: 1px solid #30363D;
    border-radius: 8px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 500;
}

SecondaryButton:hover {
    background-color: #30363D;
    border-color: #484F58;
}

DangerButton {
    background-color: rgba(248, 113, 113, 0.12);
    color: #F87171;
    border: 1px solid rgba(248, 113, 113, 0.35);
    border-radius: 8px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: bold;
}

DangerButton:hover {
    background-color: #F87171;
    color: #FFFFFF;
}

/* Tree Views, Lists, and Table Widgets */
QTreeView, QTreeWidget, QTableView, QTableWidget, QListView, QListWidget {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 8px;
    color: #F0F6FC;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
    outline: none;
    gridline-color: #21262D;
}
QTreeView::item, QTreeWidget::item, QTableView::item, QTableWidget::item, QListView::item, QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
    min-height: 26px;
}
QTreeView::item:hover, QTreeWidget::item:hover, QTableView::item:hover, QTableWidget::item:hover, QListView::item:hover, QListWidget::item:hover {
    background-color: #1F242C;
}
QTreeView::item:selected, QTreeWidget::item:selected, QTableView::item:selected, QTableWidget::item:selected, QListView::item:selected, QListWidget::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}
QTreeView::branch {
    background: transparent;
}

/* Header Views (Table & Tree Columns) */
QHeaderView::section {
    background-color: #0D1117;
    color: #8B949E;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #30363D;
    border-right: 1px solid #21262D;
    font-weight: bold;
}
QHeaderView::section:hover {
    background-color: #161B22;
    color: #F0F6FC;
}

/* Context Menus (Right-Click File/Folder Popup Menus) */
QMenu {
    background-color: #1E232B;
    border: 1px solid #30363D;
    border-radius: 8px;
    padding: 4px;
    color: #F0F6FC;
}
QMenu::item {
    background: transparent;
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    color: #F0F6FC;
}
QMenu::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}
QMenu::item:disabled {
    color: #6E7681;
}
QMenu::separator {
    height: 1px;
    background-color: #30363D;
    margin: 4px 6px;
}

/* Toolbars */
QToolBar {
    background-color: #161B22;
    border-bottom: 1px solid #30363D;
    spacing: 6px;
    padding: 4px;
}
QToolButton {
    background-color: #21262D;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 6px 12px;
    color: #F0F6FC;
}
QToolButton:hover {
    background-color: #30363D;
    color: #FFFFFF;
}
QToolButton:pressed {
    background-color: #1A1F26;
}

/* Bottom Action Panels across tools */
QFrame#bottomActionPanel {
    background-color: #161B22;
    border-top: 1px solid #30363D;
    padding-top: 6px;
}

/* Universal Converter Components */
ConversionCardWidget {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 8px;
}
ConversionCardWidget:hover {
    border-color: #0078D4;
}

DirectionButton {
    background-color: #21262D;
    border: 1px solid #30363D;
    border-radius: 6px;
}
DirectionButton:hover {
    background-color: #2D333B;
    border-color: #0078D4;
}

QFrame#quickDropBanner {
    background-color: #1A2433;
    border: 1px dashed #0078D4;
    border-radius: 8px;
}
QFrame#quickDropBanner:hover {
    background-color: #1F2D40;
    border-color: #60CDFF;
}

/* Fluent Scrollbars (Qt Widgets) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 32px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar::handle:vertical:pressed {
    background: #64748B;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 32px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #475569;
}

QScrollBar::handle:horizontal:pressed {
    background: #64748B;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

